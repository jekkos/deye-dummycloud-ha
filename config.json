{
  "name": "Deye Dummy Cloud",
  "version": "0.1.0",
  "slug": "deye-dummycloud",
  "description": "Local replacement for the Deye/Solarman cloud: microinverter loggers push data over plain TCP, published to MQTT with Home Assistant discovery.",
  "url": "https://github.com/jekkos/deye-dummycloud",
  "arch": ["armv7", "armhf", "aarch64", "amd64"],
  "startup": "services",
  "boot": "auto",
  "host_network": true,
  "services": ["mqtt:want"],
  "options": {
    "listen_port": 10000,
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "topic_prefix": "deye-dummycloud",
    "log_level": "info"
  },
  "schema": {
    "listen_port": "int(1024, 65535)",
    "mqtt_host": "str",
    "mqtt_port": "int(1, 65535)",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "topic_prefix": "str",
    "log_level": "match(trace|debug|info|warn|error|fatal)"
  }
}
